# ---- Discord ----
DISCORD_TOKEN=your-discord-bot-token-here

# ---- Hugging Face (chat / text generation — /ask, /summary, /quiz, /flashcards) ----
# Get a free token at https://huggingface.co/settings/tokens/new
# Enable the "Make calls to Inference Providers" permission on the token.
HF_API_KEY=your-hugging-face-token-here
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct

# ---- sentence-transformers (local embeddings for RAG — no key needed) ----
# Runs entirely on your machine, downloads once (~80MB), then stays cached.
# No signup, no cost, no rate limit — used for /document ingestion and search.
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ---- RAG tuning (optional, sane defaults provided) ----
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RAG_TOP_K=4

# ---- Misc ----
LOG_LEVEL=INFO
